#include <iostream>
#include <fstream>
#include <string>

using namespace std;

int main() {
    // Step 1: Create and write to color.txt
    ofstream outFile("color.txt");

    if (!outFile.is_open()) {
        cout << "Error: Unable to create color.txt" << endl;
        return 1;
    }

    outFile << "Red" << endl;
    outFile << "Blue" << endl;
    outFile << "Green" << endl;
    outFile << "Yellow" << endl;
    outFile << "Purple" << endl;

    outFile.close();

    // Step 2: Read from color.txt
    ifstream inFile("color.txt");

    if (!inFile.is_open()) {
        cout << "Error: Unable to open color.txt for reading" << endl;
        return 1;
    }

    // Step 3: Create and write to color_copy.txt
    ofstream copyFile("color_copy.txt");

    if (!copyFile.is_open()) {
        cout << "Error: Unable to create color_copy.txt" << endl;
        inFile.close();
        return 1;
    }

    string line;

    // Step 4: Copy content line by line
    while (getline(inFile, line)) {
        copyFile << line << endl;
    }

    // Step 5: Close all files
    inFile.close();
    copyFile.close();

    cout << "File copied successfully to color_copy.txt" << endl;

    return 0;
}